rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Top-level coupons collection
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Top-level families collection
    match /families/{familyId} {
      allow read, write: if true;

      // In case subcollections are used
      match /coupons/{couponId} {
        allow read, write: if true;

        match /usages/{usageId} {
          allow read, write: if true;
        }
      }
    }

    // Top-level users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Top-level invites collection
    match /invites/{inviteId} {
      allow read, write: if true;
    }

    // System connection test collection
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
